# Copy to .env when running locally; on Railway these are template variables.
# Use human-readable prose placeholders, never format-accurate fake secrets.

# Password for the auto-seeded admin account (username: admin).
WRITEFREELY_ADMIN_PASSWORD=your-admin-password-here

# Optional upstream tunables (defaults shown):
# Port is set from Railway's PORT automatically; do not set this yourself.
# WRITEFREELY_PORT=8080
# Public host is derived at boot from RAILWAY_PUBLIC_DOMAIN automatically.
# The app serves on the generated domain with HTTPS via Railway's proxy.
